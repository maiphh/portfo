# Copy to .env for local work. Never commit real values.
# Only PUBLIC_* variables are exposed to the browser.

# --- Feature flags ---
# Backend features (GitHub activity, contact queue, most-read) render
# clearly labelled sample data while this is "true" (the default).
PUBLIC_USE_MOCKS=true

# --- Site ---
# Canonical origin for the sitemap and canonical links (optional on Vercel).
SITE_URL=

# --- Database (Neon Postgres + pgvector) ---
# Neon: use the pooled connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Throwaway LOCAL database for `pnpm test`. The tests wipe its public schema.
TEST_DATABASE_URL=

# --- Contact classification (Cloudflare Workers AI REST API) ---
# The contact worker sorts messages with a small Workers AI model (default
# @cf/meta/llama-3.1-8b-instruct). CLOUDFLARE_AI_API_TOKEN needs only the
# "Workers AI: Read" permission on this account. CLASSIFY_MODEL is optional.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLASSIFY_MODEL=

# --- Chat (the separate portfo-chat Worker in workers/chat) ---
# The Worker's own secrets (TURNSTILE_SECRET_KEY, INGEST_SECRET, SESSION_SIGNING_KEY) are
# Wrangler secrets, listed in workers/chat/.dev.vars.example, not Vercel env vars.
# PUBLIC_CHAT_URL is the deployed Worker origin, e.g. https://portfo-chat.<account>.workers.dev.
# The chat window reuses PUBLIC_TURNSTILE_SITE_KEY below. It shows sample replies while
# PUBLIC_USE_MOCKS is on or PUBLIC_CHAT_URL is empty. The site's origin must be in the
# Worker's ALLOWED_ORIGINS and on the Turnstile widget's hostnames.
PUBLIC_CHAT_URL=

# --- GitHub activity sync (read-only fine-grained token) ---
# GITHUB_TOKEN: fine-grained, public repositories read-only (or classic with no scopes).
# Without it /api/cron/github-sync logs a failed sync run and answers 503.
# GITHUB_LOGIN is optional (defaults to the site's handle, maiphh).
GITHUB_TOKEN=
GITHUB_LOGIN=

# --- Contact form notifications ---
# The worker emails NOTIFY_EMAIL through Resend (spam is stored, not emailed).
# RESEND_FROM is optional (a sender on a domain verified in Resend); it defaults to
# Resend's onboarding sender, which only delivers to the Resend account's own address.
RESEND_API_KEY=
NOTIFY_EMAIL=
RESEND_FROM=

# --- Abuse protection (Cloudflare Turnstile) ---
# Without TURNSTILE_SECRET_KEY, /api/contact skips verification in dev/test (logged)
# and rejects every post in production (fail closed). The widget renders only when
# PUBLIC_TURNSTILE_SITE_KEY is set and PUBLIC_USE_MOCKS=false.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- Cron + privacy ---
# CRON_SECRET guards /api/cron/jobs and /api/cron/github-sync (Authorization: Bearer <CRON_SECRET>).
# The GitHub sync workflow also needs SITE_URL and CRON_SECRET as GitHub Actions secrets.
# VISITOR_HASH_SALT is required in production (contact form + /api/view fail closed without it);
# dev/test fall back to a fixed salt. Combined with the Asia/Ho_Chi_Minh date to make visitor_hash.
CRON_SECRET=
VISITOR_HASH_SALT=
