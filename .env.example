# Copy to .env for local work. Never commit real values.
# Only PUBLIC_* variables are exposed to the browser.
#
# This file is the Astro site (deployed on Vercel). The Worker does not read it.
# Worker secrets are in workers/portfo/.dev.vars.example
# (`wrangler secret put` in production).
#
# The build needs none of these. With PUBLIC_USE_MOCKS=true (the default) the
# contact form, view counts, GitHub activity and chat all use labelled sample
# data and make no network calls.

# --- Feature flags ---
PUBLIC_USE_MOCKS=true

# --- Site ---
# Canonical origin for the sitemap and canonical links.
# Optional on Vercel (falls back to the production URL).
SITE_URL=

# --- portfo Worker ---
# Deployed Worker origin, including https://, no trailing slash, for example
# https://portfo.<account>.workers.dev
# A bare host is accepted and treated as https.
# Empty, or PUBLIC_USE_MOCKS=true: contact, views, GitHub and chat stay on sample data.
# The site origin must be in the Worker's ALLOWED_ORIGINS.
# Worker-only secrets (not set here): SESSION_SIGNING_KEY, VISITOR_HASH_SALT,
# RESEND_API_KEY, NOTIFY_EMAIL, GITHUB_TOKEN, CRON_SECRET, …
PUBLIC_WORKER_URL=
