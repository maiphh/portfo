# Copy to .env for local work. Never commit real values.
# Only PUBLIC_* variables are exposed to the browser.
#
# This file is the Astro site (deployed on Vercel). The Workers do not read it.
# Worker secrets are in workers/api/.dev.vars.example and workers/chat/.dev.vars.example
# (`wrangler secret put` in production).
#
# The build needs none of these. With PUBLIC_USE_MOCKS=true (the default) the
# contact form, view counts, GitHub activity and chat all use labelled sample
# data and make no network calls.

# --- Feature flags ---
PUBLIC_USE_MOCKS=true

# --- Site ---
# Canonical origin for the sitemap and canonical links.
# Optional on Vercel (falls back to the production URL).
SITE_URL=

# --- API Worker (portfo-api) ---
# Deployed Worker origin, no trailing slash, for example
# https://portfo-api.<account>.workers.dev
# Empty, or PUBLIC_USE_MOCKS=true: contact, views and GitHub stay on sample data.
# The site origin must be in the Worker's ALLOWED_ORIGINS.
# Worker-only secrets (not set here): VISITOR_HASH_SALT,
# RESEND_API_KEY, NOTIFY_EMAIL, GITHUB_TOKEN, CRON_SECRET, …
PUBLIC_API_URL=

# --- Chat window → portfo-chat Worker ---
# Deployed Worker origin, no trailing slash, for example
# https://portfo-chat.<account>.workers.dev
# Empty, or PUBLIC_USE_MOCKS=true: the window shows sample replies.
# The site origin must be in the Worker's ALLOWED_ORIGINS.
# Worker-only secrets (not set here): INGEST_SECRET, SESSION_SIGNING_KEY.
PUBLIC_CHAT_URL=
