{
  "name": "portfo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio of Mai Gia Phu, AI Engineer in Ho Chi Minh City.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/preview.mjs",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm check && pnpm build",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.15",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.1",
    "astro": "^7.4.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.71.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
