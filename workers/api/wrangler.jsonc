// portfo-api: contact, views, GitHub activity. Nothing here is a secret.
// Top level is local/dev (localhost only). env.production is the launch config.
// A deploy stops if any value is still a placeholder: see build.command.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  "build": { "command": "node scripts/check-config.ts" },

  // wrangler d1 create portfo  →  put the real database_id below (both top level and production).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfo",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],

  // Same schedule as the old .github/workflows/github-sync.yml.
  "triggers": { "crons": ["17 */6 * * *"] },

  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4321",
  },

  // Secrets (never in this file): VISITOR_HASH_SALT,
  // RESEND_API_KEY, NOTIFY_EMAIL, RESEND_FROM, GITHUB_TOKEN, GITHUB_LOGIN, CRON_SECRET.

  "env": {
    "production": {
      "name": "portfo-api",
      "build": { "command": "node scripts/check-config.ts --env production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portfo",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": ["17 */6 * * *"] },
      "vars": {
        // TODO(launch): the production site origin, e.g. "https://maiphh.dev".
        "ALLOWED_ORIGINS": "https://REPLACE_ME_SITE_DOMAIN",
        "ENVIRONMENT": "production",
      },
    },
  },
}
