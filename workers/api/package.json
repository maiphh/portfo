{
  "name": "portfo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Worker for Mai Gia Phu's portfolio: contact, views, GitHub activity on Cloudflare Workers + D1.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "work": "node scripts/work.ts",
    "check:config": "node scripts/check-config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.2",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
