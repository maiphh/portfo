# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Production: `wrangler secret put <NAME>` for each. Do not put these in the Astro
# site's .env — the site only needs PUBLIC_WORKER_URL.
# Non-secret Worker settings (ALLOWED_ORIGINS, ENVIRONMENT, chat model knobs) are vars in wrangler.jsonc.

# HMAC key for chat session tokens and visitor hashes. openssl rand -base64 32
SESSION_SIGNING_KEY=

# Daily salt for visitor_hash = SHA-256(IP + UA + salt:YYYY-MM-DD). openssl rand -base64 32
# Unset in local/test: uses a fixed "portfo-dev-salt". Required when ENVIRONMENT=production.
VISITOR_HASH_SALT=

# Resend: sends one email per contact submit in the same request.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional. Default: Portfolio contact <onboarding@resend.dev> (only delivers to the Resend account).
RESEND_FROM=

# GitHub sync (Cron Trigger + POST /cron/github-sync). Public repos, read-only token.
GITHUB_TOKEN=
# Optional. Defaults to maiphh.
GITHUB_LOGIN=

# Bearer token for POST /cron/github-sync. openssl rand -base64 32
# The scheduled handler does not need it. Unset: manual route answers 503.
CRON_SECRET=
