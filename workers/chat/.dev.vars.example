# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Production: `wrangler secret put <NAME>` (same two names). Do not put these in
# the Astro site's .env. Both are Worker-only.
# Non-secret Worker settings (ALLOWED_ORIGINS, API_URL, models) are vars in wrangler.jsonc.

# Bearer token for POST /ingest (same value as the CHAT_INGEST_SECRET GitHub Actions secret).
# Generate with: openssl rand -base64 32
INGEST_SECRET=
# HMAC key for chat session tokens and visitor hashes. openssl rand -base64 32
SESSION_SIGNING_KEY=
