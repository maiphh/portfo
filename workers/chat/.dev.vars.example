# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars. Production values are
# Wrangler secrets: `wrangler secret put <NAME>`.

# Turnstile secret. For local dev use Cloudflare's always-pass test secret:
# 1x0000000000000000000000000000000AA (and site key 1x00000000000000000000AA on the page).
TURNSTILE_SECRET_KEY=
# Bearer token for POST /ingest (same value as the CHAT_INGEST_SECRET GitHub Actions secret).
# Generate with: openssl rand -base64 32
INGEST_SECRET=
# HMAC key for chat session tokens and visitor hashes. openssl rand -base64 32
SESSION_SIGNING_KEY=
