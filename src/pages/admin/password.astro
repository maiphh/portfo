---
import Portal from "~/components/wall-admin/Portal.astro";
import { ownerRedirect, ownerSession, privatePage } from "~/lib/wall-admin/server";

export const prerender = false;
privatePage(Astro);
const session = await ownerSession(Astro);
if (session === "signed-out") return ownerRedirect("/login");
if (session === "unavailable") Astro.response.status = 503;
---

<Portal title="Change password" area="password">
  <section class="owner-panel">
    <h1>Change password</h1>
    {session === "unavailable" ? (
      <p>
        The owner service is temporarily unavailable. <a href="/admin/password">Try again</a>
      </p>
    ) : (
      <form method="post" data-account-form="password">
        <label for="current-password">Current password</label>
        <input
          id="current-password"
          name="currentPassword"
          type="password"
          autocomplete="current-password"
          aria-describedby="current-error"
          required
        />
        <span class="owner-field-error" id="current-error" data-field="currentPassword"></span>
        <label for="new-password">New password</label>
        <input
          id="new-password"
          name="newPassword"
          type="password"
          autocomplete="new-password"
          aria-describedby="new-hint new-error"
          required
        />
        <small id="new-hint">Use 8–128 characters. Spaces and Unicode are allowed.</small>
        <span class="owner-field-error" id="new-error" data-field="newPassword"></span>
        <label for="confirmation">Confirm new password</label>
        <input
          id="confirmation"
          name="confirmation"
          type="password"
          autocomplete="new-password"
          aria-describedby="confirmation-error"
          required
        />
        <span class="owner-field-error" id="confirmation-error" data-field="confirmation"></span>
        <p data-form-status role="status"></p>
        <button class="owner-primary" type="submit">
          Change password
        </button>
      </form>
    )}
  </section>
</Portal>
