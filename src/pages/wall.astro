---
import "@fontsource-variable/familjen-grotesk";
import "@fontsource-variable/hubot-sans/wdth.css";
import "@fontsource-variable/jetbrains-mono";
import "~/styles/global.css";
import WallCanvas from "~/components/wall-admin/WallCanvas.astro";

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1b1a" />
    <title>Personal Wall — Mai Gia Phu</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="wall-page">
    <main>
      <WallCanvas />
    </main>
    <dialog id="wall-contribution" class="wall-editor" aria-labelledby="contribute-title">
      <form>
        <h2 id="contribute-title">Contribute to the wall</h2>
        <label for="contribution-kind">Contribution</label>
        <select id="contribution-kind">
          <option value="note">Note</option>
          <option value="photo">Photo</option>
        </select>
        <label for="contribution-title">Title</label>
        <input id="contribution-title" name="title" maxlength="100" required />
        <label id="contribution-body-label" for="contribution-body">
          Note
        </label>
        <textarea id="contribution-body" name="body" maxlength="5000" required></textarea>
        <div id="contribution-image-fields" hidden>
          <label for="contribution-photo">Photo (JPEG, PNG, or WebP, up to 4 MB)</label>
          <input
            id="contribution-photo"
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            disabled
          />
          <label for="contribution-alt">Image description (alt text)</label>
          <input id="contribution-alt" name="alt" maxlength="500" disabled />
        </div>
        <p id="contribution-status" role="status"></p>
        <div class="wall-editor-actions">
          <button id="contribution-close" type="button">
            Close
          </button>
          <button type="submit">Submit for review</button>
        </div>
      </form>
    </dialog>
    <script>
      import "~/scripts/wall-contribution";
    </script>
  </body>
</html>
