---
/**
 * Case studies: every work entry with a page renders on the shared template
 * (components/case/CaseStudy.astro), registered in src/case-studies. Entries with `page: false`
 * live only on the home page. Previous and next step through the case studies in home order.
 */
import type { CollectionEntry } from "astro:content";
import { caseStudies, isCaseStudy } from "~/case-studies";
import { getWork } from "~/lib/work";

export async function getStaticPaths() {
  const work = (await getWork()).filter((w) => w.data.page);
  for (const w of work)
    if (!isCaseStudy(w.id))
      throw new Error(`Work entry "${w.id}" has a page but no case study in src/case-studies.`);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: work[i - 1], next: work[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
const Case = caseStudies[entry.id as keyof typeof caseStudies];
---

<Case entry={entry} prev={prev} next={next} />

<script>
  import { trackPageView } from "~/scripts/analytics";
  trackPageView();
</script>
