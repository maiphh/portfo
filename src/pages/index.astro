---
import Activity from "~/components/Activity.astro";
import Contact from "~/components/Contact.astro";
import DevPanel from "~/components/DevPanel.astro";
import Hero from "~/components/Hero.astro";
import HowItWorks from "~/components/HowItWorks.astro";
import Timeline from "~/components/Timeline.astro";
import SelectedWork from "~/components/SelectedWork.astro";
import Base from "~/layouts/Base.astro";
import { getGithubSummary } from "~/lib/data";
import { USE_MOCKS } from "~/lib/flags";
import { getWork } from "~/lib/work";

const work = await getWork();
---

<Base base="">
  <Hero />
  <section id="work" data-selected-work aria-labelledby="work-h">
    <SelectedWork work={work} />
  </section>
  <Timeline />
  <Activity github={getGithubSummary()} />
  <HowItWorks />
  <Contact />
  {USE_MOCKS && <DevPanel slot="after" />}
</Base>

<script>
  import "~/scripts/home";
</script>
