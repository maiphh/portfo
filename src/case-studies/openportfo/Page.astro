---
/** OpenPortfo on the shared case-study template. Concept: two markets, one book. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { AGENT_TOOLS, openportfo } from "./data";
import "./op.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;

// Sample holdings (the same names as the home card's sample chart), no amounts.
const book = [
  { sym: "BTC", market: "Crypto", src: "CoinGecko" },
  { sym: "ETH", market: "Crypto", src: "CoinGecko" },
  { sym: "FPT", market: "HOSE", src: "vnstock" },
  { sym: "VNM", market: "HOSE", src: "vnstock" },
];
const img = (name: string) => `/work/openportfo/${name}.webp`;
---

<CaseStudy entry={entry} prev={prev} next={next} data={openportfo}>
  <div slot="signature" class="op-sig" data-book>
    <p class="mk-label">one book · sample holdings</p>
    <div class="mk-scroll">
      <table class="op-book">
        <caption class="sr-only">Sample holdings and where each is priced from</caption>
        <thead>
          <tr>
            <th scope="col">Holding</th>
            <th scope="col">Market</th>
            <th scope="col">Priced from</th>
          </tr>
        </thead>
        <tbody>
          {book.map((r) => (
            <tr data-row>
              <th scope="row">{r.sym}</th>
              <td>{r.market}</td>
              <td class="op-src">{r.src}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="op-refresh" data-refresh>
      <span aria-hidden="true">↻</span> one refresh · one batch · cached for minutes
    </p>
  </div>

  <div slot="highlight" class="op-hl">
    <img
      class="shot op-agent"
      src={img("agent")}
      width="444"
      height="708"
      loading="lazy"
      decoding="async"
      alt="The OpenPortfo chat panel: 'What can I help with?', with slash commands /search, /add, /remove, /holdings, /portfolio and /quote."
    />
    <div class="mk">
      <p class="mk-label">the agent's tools · accent = changes data</p>
      <ul class="mk-chips" aria-label="Agent tools">
        {AGENT_TOOLS.map((t) => (
          <li class:list={{ acc: t.changes }}>
            {t.name}
            {t.changes && <span class="sr-only"> (changes data)</span>}
          </li>
        ))}
      </ul>
      <p>
        The model proposes a tool call; the API runs it against the signed-in user's own holdings,
        watchlist and quotes. Tools get the resolved user, never a token, so there is no credential
        to leak into a model request.
      </p>
      <p>
        Before a tool that changes data runs, the turn's request id is marked in a per-user ledger.
        A retried message gets the first turn's answer back (or is told the outcome is unclear)
        instead of adding the same holding twice. The prompt forbids claiming a change unless a tool
        succeeded.
      </p>
    </div>
  </div>

  <div slot="dive-agent" class="mk">
    <p class="mk-label">the chat can</p>
    <ul class="mk-chips" aria-label="What the agent can do">
      <li class="acc">read the book</li>
      <li class="acc">look up a quote</li>
      <li class="acc">read the news</li>
      <li>add or remove a holding</li>
    </ul>
  </div>

  <div slot="dive-news" class="mk">
    <ul class="mk-chips" aria-label="How news arrives">
      <li>RSS feeds</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li>daily job</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li class="acc">news for your symbols</li>
    </ul>
  </div>

  <div slot="dive-email" class="mk">
    <p class="mk-label">the email carries</p>
    <ul class="mk-chips" aria-label="What the email includes">
      <li class="acc">performance</li>
      <li class="acc">price changes</li>
      <li class="acc">news</li>
    </ul>
  </div>
</CaseStudy>
