---
/** Legal RAG assistant on the shared case-study template. Concept: the annotated statute. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { legalRag } from "./data";
import { EXAMPLE, examplePrefix } from "./example";
import "./rag.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
const address = [`Số: ${EXAMPLE.docNo}`, EXAMPLE.article, EXAMPLE.clause];
---

<CaseStudy entry={entry} prev={prev} next={next} data={legalRag}>
  <div slot="signature" class="rag-sig" data-statute>
    <p class="rag-head" aria-label={`Address carried by the chunk: ${address.join(" › ")}`}>
      {address.map((a, i) => (
        <>
          {i > 0 && <i aria-hidden="true">›</i>}
          <span data-seg>{a}</span>
        </>
      ))}
    </p>
    <div class="rag-page" aria-hidden="true">
      <p class="rag-art">{EXAMPLE.article}. {EXAMPLE.articleTitle}</p>
      <div class="rag-k">
        <b>1.</b>
        <span class="rag-bars"><i></i><i></i></span>
      </div>
      <div class="rag-k rag-chunk" data-chunk>
        <code class="rag-prefix">{examplePrefix}</code>
        <b>2.</b>
        <span class="rag-bars"><i></i><i></i><i></i></span>
        <div class="rag-d"><b>a)</b><span class="rag-bars"><i></i></span></div>
        <div class="rag-d"><b>b)</b><span class="rag-bars"><i></i></span></div>
      </div>
      <div class="rag-k">
        <b>3.</b>
        <span class="rag-bars"><i></i><i></i></span>
      </div>
    </div>
  </div>

  <div slot="highlight" class="mk rag-hl">
    <div class="rag-chunkcard">
      <code>{examplePrefix}</code>
      <p>&lt;body of that article&gt;</p>
    </div>
    <ul class="mk-chips" aria-label="The address path a chunk keeps">
      <li>document number</li>
      <li class="sep" aria-hidden="true">›</li>
      <li>Điều</li>
      <li class="sep" aria-hidden="true">›</li>
      <li>Khoản</li>
      <li class="sep" aria-hidden="true">›</li>
      <li>Điểm</li>
    </ul>
    <div class="rag-paths">
      <p class="mk-label">HTML path stamps</p>
      <code>[Số: … &gt; Điều N. Title]</code>
      <p class="mk-label">PDF path stamps</p>
      <code>[doc id | title | level]</code>
    </div>
    <p>
      HTML splits only on the page's own <code>&lt;a name="dieu_N"&gt;</code>. A công văn is not
      given a made-up Điều.
    </p>
  </div>

  <div slot="dive-repair" class="mk mk-two rag-repair">
    <div>
      <p class="mk-label">coarse split</p>
      <ul class="rag-blocks">
        <li class="bad">… ends on a bare “Điều N”</li>
        <li class="dim">body that follows</li>
        <li class="bad">“Khoản 1” alone, under 50 chars</li>
      </ul>
    </div>
    <div>
      <p class="mk-label">after the repair pass</p>
      <ul class="rag-blocks">
        <li class="ok">header merged into its body</li>
        <li class="ok">“Khoản 1” merged forward</li>
      </ul>
      <p class="rag-small">
        The next block is told the previous level, so “3.” stays under that article.
      </p>
    </div>
  </div>

  <div slot="dive-fallback" class="mk rag-chain">
    <ol>
      <li>
        <code>label</code>
        <span>JSON only, verbatim text, the previous level as a hint</span>
      </li>
      <li>
        <code>retry × 3</code>
        <span>fences stripped, the brace-matched object kept</span>
      </li>
      <li>
        <code>semantic split</code>
        <span>break where sentence similarity drops, instead of dropping the block</span>
      </li>
      <li>
        <code>dedupe</code>
        <span>near-copies inside one Điều collapse; the longer chunk stays</span>
      </li>
    </ol>
  </div>

  <div slot="dive-refuse" class="mk rag-refuse" data-refuse>
    <div class="rag-q">
      <p class="mk-label">a question with no qualifying chunk</p>
      <p class="rag-fallback" lang="vi">Xin lỗi, tôi không tìm thấy thông tin cần thiết.</p>
    </div>
    <ul class="mk-chips" aria-label="Retrieval defaults">
      <li>top_k 6</li>
      <li>rerank off by default</li>
      <li>threshold 0.7</li>
      <li>keep 2</li>
      <li>pgvector cosine</li>
    </ul>
  </div>
</CaseStudy>
