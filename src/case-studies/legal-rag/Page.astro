---
/** Legal RAG assistant on the shared case-study template. Concept: the annotated statute. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { legalRag } from "./data";
import { SCENES } from "./scenes";
import { examplePrefix } from "./example";
import "./rag.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} data={legalRag} scenes={SCENES}>
  <div slot="highlight" class="mk rag-hl">
    <div class="rag-chunkcard">
      <code>{examplePrefix}</code>
      <p>&lt;body of that article&gt;</p>
    </div>
    <ul class="mk-chips" aria-label="The address path a chunk keeps">
      <li>document number</li>
      <li class="sep" aria-hidden="true">
        ›
      </li>
      <li>Điều</li>
      <li class="sep" aria-hidden="true">
        ›
      </li>
      <li>Khoản</li>
      <li class="sep" aria-hidden="true">
        ›
      </li>
      <li>Điểm</li>
    </ul>
    <div class="rag-paths">
      <p class="mk-label">HTML path stamps</p>
      <code>[Số: … &gt; Điều N. Title]</code>
      <p class="mk-label">PDF path stamps</p>
      <code>[doc id | title | level]</code>
    </div>
    <p>
      HTML splits only on the page's own <code>&lt;a name="dieu_N"&gt;</code>. A công văn is not
      given a made-up Điều.
    </p>
  </div>
</CaseStudy>
