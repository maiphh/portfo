---
/** Ecom shop template on the shared case-study template. Concept: one engine, many storefronts.
 * Both repos are private, so every artifact is an illustration (labelled in its caption). */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { ecom } from "./data";
import { SCENES } from "./scenes";
import "./ecom.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;

const rules: [event: string, from: string, result: string, ok: boolean][] = [
  ["payment_received", "awaiting_payment, amount and order id match", "paid", true],
  ["payment_received", "cancelled", "rejected: unapplied", false],
  ["payment_received", "any other state", "rejected: illegal", false],
  ["fulfil", "collect_on_delivery", "paid (provider cod), receipt written", true],
];
const buyer: [string, string][] = [
  ["/", "Catalog"],
  ["/product/[slug]", "One product"],
  ["/cart", "Cart and checkout"],
  ["/orders, /orders/[id]", "The buyer's orders"],
];
const desk: [string, string][] = [
  ["/desk", "Home of the desk"],
  ["/desk/products", "Catalog the seller edits"],
  ["/desk/orders", "Orders"],
  ["/desk/sales · events · codes", "Sales, events, codes"],
];
---

<CaseStudy entry={entry} prev={prev} next={next} data={ecom} scenes={SCENES}>
  <div slot="highlight" class="mk ec-machine">
    <ul class="mk-chips" aria-label="The usual path of a paid order">
      <li class="acc">awaiting_payment</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li class="acc">paid</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li>fulfilled</li>
    </ul>
    <div class="mk-scroll" data-scroll-x>
      <table>
        <caption class="sr-only">How the step function answers an event</caption>
        <thead>
          <tr>
            <th scope="col">Event</th>
            <th scope="col">From</th>
            <th scope="col">Result</th>
          </tr>
        </thead>
        <tbody>
          {rules.map(([e, f, r, ok]) => (
            <tr>
              <th scope="row">
                <code>{e}</code>
              </th>
              <td>{f}</td>
              <td class:list={["ec-res", { bad: !ok }]}>{r}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      The step function is pure: it takes the order and the event and returns the next state or a
      rejection. A payment notice from a webhook and a cash-on-delivery fulfilment both go through
      it, and adding a payment provider doesn't edit it.
    </p>
  </div>

  <div slot="extra" class="mk ec-routes">
    <div>
      <p class="mk-label">buyer · src/app/(store)</p>
      <div class="mk-scroll">
        <table>
          <caption class="sr-only">Buyer routes</caption>
          <tbody>
            {buyer.map(([p, w]) => (
              <tr>
                <th scope="row">
                  <code>{p}</code>
                </th>
                <td>{w}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div>
      <p class="mk-label">seller desk · src/app/(desk)/desk</p>
      <div class="mk-scroll">
        <table>
          <caption class="sr-only">Seller desk routes</caption>
          <tbody>
            {desk.map(([p, w]) => (
              <tr>
                <th scope="row">
                  <code>{p}</code>
                </th>
                <td>{w}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="ec-small">
        <code>/admin</code> redirects to the desk. Buyers never see its layout.
      </p>
    </div>
  </div>
</CaseStudy>
