---
/** POET on the shared case-study template. Concept: warm pages, a strict server. Real captures of
 * the live site (no photos of children), framed inside the portfolio's dark system. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { poet } from "./data";
import { SCENES } from "./scenes";
import "./poet.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;

const img = (name: string) => `/work/poet/${name}.webp`;
---

<CaseStudy entry={entry} prev={prev} next={next} data={poet} scenes={SCENES}>
  <div slot="highlight" class="shots two pt-hl">
    <img
      class="shot"
      src={img("form")}
      width="800"
      height="1223"
      loading="lazy"
      decoding="async"
      alt="The Ủng hộ form on the live site: a warm coat (Áo ấm, 200.000 đ) picked, a sample name and message filled in, and the button 'Tặng 1 Áo ấm · 200.000 đ'. Not submitted."
    />
    <img
      class="shot"
      src={img("letter")}
      width="900"
      height="1125"
      loading="lazy"
      decoding="async"
      alt="The thank-you letter (Thư cảm ơn · POET) addressed to the sample donor, for 200.000 đ, with their message and the date."
    />
  </div>
</CaseStudy>
