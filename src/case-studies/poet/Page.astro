---
/** POET on the shared case-study template. Concept: warm pages, a strict server. Real captures of
 * the live site (no photos of children), framed inside the portfolio's dark system. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { poet } from "./data";
import "./poet.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;

const path = [
  { t: "Ủng hộ form", s: "pick a gift, leave a name" },
  { t: "Worker", s: "creates the PayOS link" },
  { t: "PayOS", s: "checkout" },
  { t: "Signed webhook", s: "signature checked", paid: true },
  { t: "D1", s: "status: paid" },
  { t: "Admin publishes", s: "then the wall shows it" },
];
const img = (name: string) => `/work/poet/${name}.webp`;
---

<CaseStudy entry={entry} prev={prev} next={next} data={poet}>
  <div slot="signature" class="pt-sig" data-money>
    <ol class="pt-path">
      {path.map((p) => (
        <li class:list={{ paid: p.paid }} data-step data-paid={p.paid ? "" : undefined}>
          <b>{p.t}</b>
          <span>{p.s}</span>
        </li>
      ))}
    </ol>
    <p class="pt-dead">
      <span aria-hidden="true">↳</span> return URL: shows a receipt, never writes paid
    </p>
  </div>

  <div slot="highlight" class="shots two pt-hl">
    <img
      class="shot"
      src={img("form")}
      width="800"
      height="1223"
      loading="lazy"
      decoding="async"
      alt="The Ủng hộ form on the live site: a warm coat (Áo ấm, 200.000 đ) picked, a sample name and message filled in, and the button 'Tặng 1 Áo ấm · 200.000 đ'. Not submitted."
    />
    <img
      class="shot"
      src={img("letter")}
      width="900"
      height="1125"
      loading="lazy"
      decoding="async"
      alt="The thank-you letter (Thư cảm ơn · POET) addressed to the sample donor, for 200.000 đ, with their message and the date."
    />
  </div>

  <div slot="dive-donate" class="mk">
    <ul class="mk-chips" aria-label="A real donation">
      <li>Ủng hộ form</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li>PayOS checkout</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li class="acc">gift paid</li>
    </ul>
  </div>

  <img
    slot="dive-wall"
    class="shot"
    src={img("wall")}
    width="1240"
    height="660"
    loading="lazy"
    decoding="async"
    alt="The gift wall: a top-three podium and a searchable list with two sample gifts, one named and one shown as 'Một nhà hảo tâm'."
  />
</CaseStudy>
