---
/** POET on the shared case-study template. Concept: warm pages, a strict server. Real captures of
 * the live site (no photos of children), framed inside the portfolio's dark system. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { poet } from "./data";
import "./poet.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;

const path = [
  { t: "Ủng hộ form", s: "pick a gift, leave a name" },
  { t: "Worker", s: "creates the PayOS link" },
  { t: "PayOS", s: "checkout" },
  { t: "Signed webhook", s: "signature checked", paid: true },
  { t: "D1", s: "status: paid" },
  { t: "Admin publishes", s: "then the wall shows it" },
];
const routes: [string, string][] = [
  ["POST /api/donations", "Create a payment: the Worker asks PayOS for a link and stores the row."],
  [
    "POST /api/webhooks/payos",
    "PayOS says a payment landed. Signature checked: the only write of paid.",
  ],
  ["GET /api/donations/:code", "Status for the receipt page. No name, no message."],
  ["GET /api/donations", "The public wall: published gifts only."],
  ["Return and cancel URLs", "Send the browser to the receipt. Never write paid."],
];
const img = (name: string) => `/work/poet/${name}.webp`;
---

<CaseStudy entry={entry} prev={prev} next={next} data={poet}>
  <div slot="signature" class="pt-sig" data-money>
    <ol class="pt-path">
      {path.map((p) => (
        <li class:list={{ paid: p.paid }} data-step data-paid={p.paid ? "" : undefined}>
          <b>{p.t}</b>
          <span>{p.s}</span>
        </li>
      ))}
    </ol>
    <p class="pt-dead">
      <span aria-hidden="true">↳</span> return URL: shows a receipt, never writes paid
    </p>
  </div>

  <div slot="highlight" class="shots two pt-hl">
    <img
      class="shot"
      src={img("form")}
      width="800"
      height="1223"
      loading="lazy"
      decoding="async"
      alt="The Ủng hộ form on the live site: a warm coat (Áo ấm, 200.000 đ) picked, a sample name and message filled in, and the button 'Tặng 1 Áo ấm · 200.000 đ'. Not submitted."
    />
    <img
      class="shot"
      src={img("letter")}
      width="900"
      height="1125"
      loading="lazy"
      decoding="async"
      alt="The thank-you letter (Thư cảm ơn · POET) addressed to the sample donor, for 200.000 đ, with their message and the date."
    />
  </div>

  <div slot="dive-paid" class="mk">
    <div class="mk-scroll" data-scroll-x>
      <table>
        <caption class="sr-only">The Worker's routes</caption>
        <thead>
          <tr>
            <th scope="col">Route</th>
            <th scope="col">What it does</th>
          </tr>
        </thead>
        <tbody>
          {routes.map(([r, w], i) => (
            <tr class:list={{ "pt-key": i === 1 }}>
              <th scope="row">
                <code>{r}</code>
              </th>
              <td>{w}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <img
    slot="dive-wall"
    class="shot"
    src={img("wall")}
    width="1240"
    height="660"
    loading="lazy"
    decoding="async"
    alt="The gift wall: a top-three podium and a searchable list with two sample gifts, one named and one shown as 'Một nhà hảo tâm'."
  />

  <img
    slot="dive-pages"
    class="shot pt-home"
    src={img("home-hero")}
    width="630"
    height="740"
    loading="lazy"
    decoding="async"
    alt="POET's home page opening: 'Tuổi trẻ. Nhiệt huyết. Nghệ thuật.' with a short introduction and two buttons."
  />
</CaseStudy>
