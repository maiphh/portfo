---
/** Document OCR: the first page on the shared case-study template. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { ocr } from "./data";
import "./ocr.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} data={ocr}>
  <div slot="highlight" class="ocr-tpl">
    <ul class="ocr-tpl-parts">
      <li>
        <code>schema</code>
        <span>fields, and where each one lands in the workbook</span>
      </li>
      <li>
        <code>prompts</code>
        <span>missing values stay null; the model is told not to guess</span>
      </li>
      <li>
        <code>rules</code>
        <span>copy_field · strip · pattern · python</span>
      </li>
      <li>
        <code>workbook</code>
        <span>the Excel layout the export fills</span>
      </li>
    </ul>
    <p
      class="ocr-tpl-run"
      aria-label="A run freezes the template and a preprocess plan on the session"
    >
      <code>template</code>
      <i aria-hidden="true"></i>
      <code>frozen on the session</code>
      <i aria-hidden="true"></i>
      <code>+ preprocess plan</code>
    </p>
    <p class="ocr-tpl-note">
      A later template edit cannot change a job already in flight. Preprocessing (split, DPI,
      filters) is chosen when a run starts; it isn't inside the portable template file yet.
    </p>
  </div>

  <div slot="dive-template" class="ocr-api">
    <div>
      <code>schema</code>
      <p>The fields to read, and the workbook column each one fills.</p>
    </div>
    <div>
      <code>prompts</code>
      <p>What the model is asked. A missing value stays empty.</p>
    </div>
    <div>
      <code>rules</code>
      <p>How values are cleaned before anyone reviews them.</p>
    </div>
    <div>
      <code>workbook</code>
      <p>The Excel layout the export fills.</p>
    </div>
  </div>

  <div slot="dive-queue" class="ocr-api">
    <div>
      <code>render queue</code>
      <p>Page images. It keeps running while extraction waits on the model.</p>
    </div>
    <div>
      <code>extract queue</code>
      <p>The slow step. Jobs take turns, so one document cannot fill it.</p>
    </div>
  </div>

  <div slot="dive-api" class="ocr-api">
    <div>
      <code>keys</code>
      <p>Created for each connected system. Shown once, stored as a hash.</p>
    </div>
    <div>
      <code>call</code>
      <p>Files and a template, the same inputs as the upload screen.</p>
    </div>
    <div>
      <code>result</code>
      <p>The fields and the filled workbook.</p>
    </div>
  </div>
</CaseStudy>
