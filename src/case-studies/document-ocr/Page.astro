---
/** Document OCR: the first page on the shared case-study template. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { ocr } from "./data";
import "./ocr.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} data={ocr}>
  <div slot="highlight" class="ocr-tpl">
    <ul class="ocr-tpl-parts">
      <li>
        <code>schema</code>
        <span>fields, and where each one lands in the workbook</span>
      </li>
      <li>
        <code>prompts</code>
        <span>missing values stay null; the model is told not to guess</span>
      </li>
      <li>
        <code>rules</code>
        <span>copy_field · strip · pattern · python</span>
      </li>
      <li>
        <code>workbook</code>
        <span>the Excel layout the export fills</span>
      </li>
    </ul>
    <p
      class="ocr-tpl-run"
      aria-label="A run freezes the template and a preprocess plan on the session"
    >
      <code>template</code>
      <i aria-hidden="true"></i>
      <code>frozen on the session</code>
      <i aria-hidden="true"></i>
      <code>+ preprocess plan</code>
    </p>
    <p class="ocr-tpl-note">
      A later template edit cannot change a job already in flight. Preprocessing (split, DPI,
      filters) is chosen when a run starts; it isn't inside the portable template file yet.
    </p>
  </div>
</CaseStudy>
