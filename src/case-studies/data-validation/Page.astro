---
/** DVP · payroll data validation on the shared case-study template. Concept: the rule compiler. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { dvp } from "./data";
import { SCENES } from "./scenes";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} data={dvp} scenes={SCENES}>
  <div slot="highlight" class="mk dvp-contract">
    <pre class="mk-code"><code><span class="c"># one function, one JSON envelope · PROMPT_VERSION "v4" is in the cache key</span>
<span class="k">def</span> calculate_&lt;rule_id&gt;(data, context):
    <span class="c"># no imports · only the sheets and earlier rules the formula cites</span>
    ...</code></pre>
    <ul class="mk-chips" aria-label="What the contract fixes">
      <li class="acc">one signature</li>
      <li class="acc">no imports</li>
      <li class="acc">cited sheets only</li>
      <li class="acc">≤ 3 examples</li>
      <li class="acc">rule text fenced as payload</li>
    </ul>
    <p>
      The rule text is fenced as payload, so a formula can't rewrite the instructions. Changing the
      contract without bumping the version would reuse old code; tests pin it at <code>"v4"</code>.
    </p>
  </div>
</CaseStudy>
