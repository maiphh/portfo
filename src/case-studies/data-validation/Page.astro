---
/** DVP · payroll data validation on the shared case-study template. Concept: the rule compiler. */
import type { CollectionEntry } from "astro:content";
import CaseStudy from "~/components/case/CaseStudy.astro";
import { dvp } from "./data";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
}
const { entry, prev, next } = Astro.props;
---

<CaseStudy entry={entry} prev={prev} next={next} data={dvp}>
  <div slot="highlight" class="mk dvp-contract">
    <pre class="mk-code"><code><span class="c"># one function, one JSON envelope · PROMPT_VERSION "v4" is in the cache key</span>
<span class="k">def</span> calculate_&lt;rule_id&gt;(data, context):
    <span class="c"># no imports · only the sheets and earlier rules the formula cites</span>
    ...</code></pre>
    <ul class="mk-chips" aria-label="What the contract fixes">
      <li class="acc">one signature</li>
      <li class="acc">no imports</li>
      <li class="acc">cited sheets only</li>
      <li class="acc">≤ 3 examples</li>
      <li class="acc">rule text fenced as payload</li>
    </ul>
    <p>
      The rule text is fenced as payload, so a formula can't rewrite the instructions. Changing the
      contract without bumping the version would reuse old code; tests pin it at <code>"v4"</code>.
    </p>
  </div>

  <div slot="dive-validate" class="mk">
    <p class="mk-label">matches the stored structure</p>
    <ul class="mk-chips" aria-label="File matches">
      <li class="acc">same sheets and columns</li>
      <li>the month can run</li>
    </ul>
    <p class="mk-label">structure changed</p>
    <ul class="mk-chips" aria-label="File does not match">
      <li class="bad">unknown sheet or column</li>
      <li class="acc">ask the user to map it</li>
    </ul>
  </div>

  <div slot="dive-translate" class="mk">
    <ul class="mk-chips dvp-steps" aria-label="Translation retry">
      <li>translate the rule</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li>check the code</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li>retry with the error</li>
      <li class="sep" aria-hidden="true">
        →
      </li>
      <li class="acc">store the function</li>
    </ul>
    <p>Out of attempts, that rule returns nothing. The rest of the client still translates.</p>
  </div>

  <div slot="dive-sandbox" class="mk">
    <p class="mk-label">__import__ allows</p>
    <ul class="mk-chips" aria-label="Allowed imports">
      <li>re</li>
      <li>math</li>
      <li>datetime</li>
      <li>decimal</li>
      <li>statistics</li>
      <li>collections</li>
    </ul>
    <p class="mk-label">rejected</p>
    <ul class="mk-chips" aria-label="Rejected">
      <li class="bad">import …</li>
      <li class="bad">open</li>
      <li class="bad">setattr(…)</li>
      <li class="bad">a helper used as the rule</li>
    </ul>
  </div>
</CaseStudy>
