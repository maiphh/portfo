---
import { site } from "~/lib/site";

interface Props {
  /** "" on the home page (in-page anchors), "/" elsewhere. */
  base?: "" | "/";
}
const { base = "" } = Astro.props;
const h = (id: string) => `${base}#${id}`;
const links = [
  { id: "work", label: "Work" },
  { id: "timeline", label: "Experience" },
  { id: "activity", label: "Activity" },
  { id: "how", label: "How it works" },
];
const menu = [
  { id: "work", label: "Work" },
  { id: "timeline", label: "Experience" },
  { id: "activity", label: "Activity" },
  { id: "how", label: "How it works" },
  { id: "contact", label: "Contact" },
];
---

<header class="nav">
  <div class="wrap">
    <a class="wordmark" href={base ? "/" : "#top"}>
      {site.name}
    </a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={h(l.id)}>{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="nav-end">
      <a class="btn btn-lime" href={h("contact")}>
        Get in touch
      </a>
      <details class="menu">
        <summary>Menu</summary>
        <ul>
          {menu.map((l) => (
            <li>
              <a href={h(l.id)}>{l.label}</a>
            </li>
          ))}
          <li>
            <button type="button" class="menu-chat" data-chat-open>
              Ask my assistant
            </button>
          </li>
        </ul>
      </details>
    </div>
  </div>
  <span class="scanbar" aria-hidden="true" data-scanbar></span>
</header>

<script>
  import { initMenu } from "~/scripts/nav";
  initMenu();
</script>
