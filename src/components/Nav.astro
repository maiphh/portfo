---
import Icon from "./Icon.astro";
import { site } from "~/lib/site";

interface Props {
  /** "" on the home page (in-page anchors), "/" elsewhere. */
  base?: "" | "/";
}
const { base = "" } = Astro.props;
const h = (id: string) => `${base}#${id}`;
const links = [
  { id: "work", label: "Work" },
  { id: "timeline", label: "Experience" },
  { id: "activity", label: "Activity" },
  { id: "how", label: "How it works" },
];
const menu = [
  { id: "work", label: "Work" },
  { id: "timeline", label: "Experience" },
  { id: "ask", label: "Ask about my work" },
  { id: "activity", label: "Activity" },
  { id: "how", label: "How it works" },
  { id: "contact", label: "Contact" },
];
---

<header class="nav">
  <div class="wrap">
    <a class="wordmark" href={base ? "/" : "#top"}>
      {site.name}
    </a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={h(l.id)}>{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="nav-end">
      <a class="ask-btn" href={h("ask")} data-ask>
        <Icon name="search" />
        <span>
          Ask<span class="long"> about my work</span>
        </span>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <a class="btn btn-lime" href={h("contact")}>
        Get in touch
      </a>
      <details class="menu">
        <summary>Menu</summary>
        <ul>
          {menu.map((l) => (
            <li>
              <a href={h(l.id)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
  <span class="scanbar" aria-hidden="true" data-scanbar></span>
</header>
