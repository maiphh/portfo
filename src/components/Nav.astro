---
import { site } from "~/lib/site";
import "~/styles/nav.css";

interface Props {
  base?: "" | "/";
}

const { base = "" } = Astro.props;
const h = (id: string) => `${base}#${id}`;
const sections = [
  { id: "timeline", label: "Experience", description: "Where I’ve worked and studied." },
  { id: "work", label: "Work", description: "Selected projects and case studies." },
  { id: "activity", label: "Activity", description: "What I’ve been building on GitHub." },
  { id: "how", label: "How it works", description: "A look at how I built this portfolio." },
];
const previews = [
  {
    label: "Wall",
    title: "Memory Wall",
    description: "Find out more about Phu through photos and notes.",
    href: "/wall",
  },
  {
    label: "BMC",
    title: "Buy me Claude",
    description: "Support my work with a donation.",
  },
] as const;
---

<header class="nav" data-home-nav={!base ? "" : undefined}>
  <nav class="wrap nav-inner" aria-label="Primary">
    <a class="wordmark" href={base ? "/" : "#top"}>
      {site.name}
    </a>
    {[false, true].map((mobile) => {
      const Group = mobile ? "details" : "div";
      const disclosureGroup = mobile ? "mobile-nav" : "desktop-nav";
      return (
        <Group class:list={["nav-group", mobile && "nav-mobile"]}>
          {mobile && <summary class="nav-menu-toggle">Menu</summary>}
          <ul class="nav-items">
            <li>
              <details class="nav-item" name={disclosureGroup}>
                <summary>Me</summary>
                <div class="nav-panel nav-me">
                  <ul class="nav-grid">
                    {sections.map(({ id, label, description }) => (
                      <li>
                        <a href={h(id)} data-nav-section={id}>
                          <span class="nav-title">{label}</span>
                          <span class="nav-description">{description}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
            {previews.map((preview) => (
              <li>
                <details class="nav-item" name={disclosureGroup}>
                  <summary>{preview.label}</summary>
                  <div class="nav-panel nav-preview">
                    <span class="nav-title">{preview.title}</span>
                    <p class="nav-description">{preview.description}</p>
                    {"href" in preview ? (
                      <a class="nav-preview-link" href={preview.href}>
                        Open wall
                      </a>
                    ) : (
                      <span class="nav-status">Coming soon</span>
                    )}
                  </div>
                </details>
              </li>
            ))}
            {mobile && (
              <li>
                <button type="button" class="menu-chat" data-chat-open>
                  Ask my assistant
                </button>
              </li>
            )}
          </ul>
        </Group>
      );
    })}
    <a class="btn btn-lime nav-contact" href={h("contact")} data-nav-section="contact">
      Get in Touch
    </a>
  </nav>
  <span class="scanbar" aria-hidden="true" data-scanbar></span>
</header>

<script>
  import { initNav } from "~/scripts/nav";
  initNav();
</script>
