---
/**
 * GitHub activity. Mocks on: labelled sample data. Mocks off: an empty shell that
 * src/scripts/activity.ts fills from /api/activity (synced every 6 hours).
 */
import type { GithubSummary } from "~/lib/types";
import { site } from "~/lib/site";
import Icon from "./Icon.astro";
import MockNote from "./MockNote.astro";

interface Props {
  github: GithubSummary | null;
}
const { github } = Astro.props;
const fmt = (n: number) => n.toLocaleString("en-US");
const syncLabel = (iso: string) => {
  const d = new Date(iso);
  const time = new Intl.DateTimeFormat("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Asia/Ho_Chi_Minh",
  }).format(d);
  return `last sync today ${time} (UTC+7)`;
};
const icon = { commit: "commit", pr: "pr", issue: "issue", star: "star" } as const;
---

<section class="sec" id="activity" aria-labelledby="gh-h">
  <div class="wrap">
    <div class="head" style="margin-bottom:var(--s5)">
      <h2 id="gh-h" data-split>
        What I'm building lately
      </h2>
    </div>
    {github ? (
      <>
        <p class="gh-line">
          From <a href={site.github}>github.com/{site.githubHandle}</a>:{" "}
          <b class="num" data-count={github.publicRepos}>
            {github.publicRepos}
          </b>{" "}
          public repos,{" "}
          <b class="num">
            <span data-count={github.commitsLastYear}>{fmt(github.commitsLastYear)}</span> commits
          </b>{" "}
          in the last year, and a{" "}
          <b class="num" data-count={github.streakDays}>
            {github.streakDays}
          </b>
          -day streak.
          <sup class="fn" aria-hidden="true">
            †
          </sup>
          <span class="sr-only"> (sample numbers)</span>
        </p>
        <MockNote text="Sample numbers until the GitHub sync is connected." />
        <div class="gh-grid">
          <div>
            <div
              class="hm-scroll"
              data-hm-scroll
              role="region"
              aria-label="Contribution heatmap, fitting its container"
            >
              <div
                class="hm"
                data-heatmap
                role="img"
                aria-label="Sample heatmap of daily commits over 52 weeks, busier in recent months"
              >
                {github.heatmap.map((lv) => (lv ? <i class={`l${lv}`} /> : <i />))}
              </div>
            </div>
            <div class="hm-foot">
              <span>
                Synced every 6 hours · {syncLabel(github.lastSyncedAt)}
                <sup class="fn" aria-hidden="true">
                  †
                </sup>
              </span>
              <span class="legend" aria-hidden="true">
                Less <i style="background:#242422" />
                <i style="background:#36421c" />
                <i style="background:#5a7424" />
                <i style="background:#95bd3a" />
                <i style="background:#d4f56b" /> More
              </span>
            </div>
          </div>
          <div>
            <ul class="feed" aria-label="Recent activity (sample)">
              {github.feed.map((f) => (
                <li>
                  <Icon name={icon[f.kind]} />
                  <b>{f.text}</b>
                  <span>{f.when}</span>
                </li>
              ))}
            </ul>
            <a class="link" href={site.github}>
              All activity on GitHub
              <Icon name="out" />
            </a>
          </div>
        </div>
      </>
    ) : (
      <div data-gh-live data-handle={site.githubHandle}>
        <p class="gh-line" data-gh-line>
          My public work lives on <a href={site.github}>github.com/{site.githubHandle}</a>.
        </p>
        <div class="gh-grid" data-gh-body hidden>
          <div>
            <div
              class="hm-scroll"
              data-hm-scroll
              role="region"
              aria-label="Contribution heatmap, fitting its container"
            >
              <div
                class="hm"
                data-gh-heatmap
                role="img"
                aria-label="Heatmap of public GitHub activity over the last 52 weeks"
              />
            </div>
            <div class="hm-foot">
              <span data-gh-sync>Synced every 6 hours</span>
              <span class="legend" aria-hidden="true">
                Less <i style="background:#242422" />
                <i style="background:#36421c" />
                <i style="background:#5a7424" />
                <i style="background:#95bd3a" />
                <i style="background:#d4f56b" /> More
              </span>
            </div>
            <p class="gh-scope">Counts cover public repos, not forks or archived ones.</p>
          </div>
          <div>
            <ul class="feed" data-gh-feed aria-label="Recent public activity" />
            <a class="link" href={site.github}>
              All activity on GitHub
              <Icon name="out" />
            </a>
          </div>
        </div>
        <p class="empty" data-gh-status role="status">
          Recent activity loads with JavaScript. It's all on GitHub too.
        </p>
      </div>
    )}
    <!-- TODO(content): GitHub display name shows "Lucas Mai"; confirm which name the site uses. -->
  </div>
</section>
