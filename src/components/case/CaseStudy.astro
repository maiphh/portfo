---
/**
 * The shared case-study page (portfo-design case-studies/moodboards/case-study-skeleton.md):
 * Hero A (CaseHeroTitle) → rail → overview → the short cut (flagged video) → the highlight →
 * how it works (FlowDiagram) → highlights → limits → next. Each project passes its data
 * (lib/case.ts) and fills slots:
 *   highlight      the one component that proves the claim
 *   extra          the body of the optional extra section (data.extra), after the deep dives
 * The hero lists the entry's `links` (live site, repository) and an optional credit line.
 * The accent comes from the work entry; the badge from its `org_badge`.
 * Each highlight gets one drawing with one looping motion (FlowFigure, lib/highlights; HIGHLIGHTS-SPEC
 * v3 §2–§3); the iso-glow credit goes in the footer of the pages with an iso drawing only.
 */
import type { CollectionEntry } from "astro:content";
import CaseHeroTitle from "~/components/case/CaseHeroTitle.astro";
import FlowDiagram from "~/components/flow/FlowDiagram.astro";
import Icon from "~/components/Icon.astro";
import FlowFigure from "~/components/case/FlowFigure.astro";
import Base from "~/layouts/Base.astro";
import type { CaseStudyData } from "~/lib/case";
import { ISO_CREDIT } from "~/lib/credit";
import { CASE_VIDEOS } from "~/lib/flags";
import { scene } from "~/lib/highlights";
import { plateVars } from "~/lib/iso/accent";
import { richText } from "~/lib/flow/types";
import { site } from "~/lib/site";
import "~/styles/case.css";
import "~/styles/highlights.css";

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work"> | undefined;
  next?: CollectionEntry<"work"> | undefined;
  data: CaseStudyData;
}
const { entry, prev, next, data } = Astro.props;
const d = entry.data;
const acc = d.accent ?? { line: "#d4f56b", tint: "#262b17" };
const { overview: o, how, dives, limits, extra } = data;

const dive = dives.map((x) => {
  const sc = scene(entry.id, x.id);
  if (!sc) throw new Error(`${entry.id}: dive "${x.id}" has no highlight drawing`);
  return { ...x, scene: sc };
});
const hasIso = dive.some((x) => x.scene.iso);
const showVideo = CASE_VIDEOS.has(entry.id) ? data.video : undefined;
const rail = [
  { href: "#overview", label: "Overview" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#deep-dives", label: "Highlights" },
  ...(extra ? [{ href: `#${extra.id}`, label: extra.rail }] : []),
  { href: "#limits", label: "Limits" },
];
const devTodos = [...(o.outcome ? [] : [o.outcomeTodo ?? "Outcome: to be added."]), ...d.todo];
---

<Base
  title={`${d.title} · ${site.name}`}
  description={d.summary}
  credit={hasIso ? ISO_CREDIT : undefined}
>
  <article
    class="cs2"
    aria-labelledby="cs-h"
    data-view-slug={entry.id}
    data-case
    data-motion={data.motion}
    style={`--acc:${acc.line};--acc-tint:${acc.tint};${plateVars(acc.line)}`}
  >
    <div class="wrap">
      <nav class="cs2-crumbs" aria-label="Breadcrumb">
        <a href="/#work">Work</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{d.title}</span>
      </nav>
      <CaseHeroTitle entry={entry} data={data} />
    </div>

    <nav class="cs2-rail" aria-label="On this page" data-rail data-sticky-top>
      <div class="wrap">
        {/* The hero's scan line "lands" here as an accent hairline (scripts/case/hero-a.ts). */}
        <i class="cs2-rail__ln" aria-hidden="true" />
        <ul data-scroll-x>
          {rail.map((r) => (
            <li>
              <a href={r.href}>
                {r.label}
                {r.href === "#deep-dives" && (
                  <>
                    <span class="cs2-rail__n" aria-hidden="true">
                      {String(dives.length).padStart(2, "0")}
                    </span>
                    <span class="sr-only"> ({dives.length})</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="wrap">
      <section class="cs2-sec cs2-pso" id="overview" aria-labelledby="ov-h">
        <h2 id="ov-h" class="sr-only">
          Overview
        </h2>
        <div>
          <h3>Problem</h3>
          <p set:html={richText(o.problem)} />
        </div>
        <div>
          <h3>Solution</h3>
          <p set:html={richText(o.solution)} />
        </div>
        {o.outcome ? (
          <div>
            <h3>Outcome</h3>
            <p set:html={richText(o.outcome)} />
          </div>
        ) : (
          <div class="cs2-todo" data-dev-only hidden>
            <h3>Outcome</h3>
            <p>
              <b>TODO (Phu):</b> Result: to be added. {o.outcomeTodo}
            </p>
          </div>
        )}
      </section>

      {showVideo && (
        <section class="cs2-sec cs2-video" id="video" aria-labelledby="vid-h">
          <div class="cs2-video-head">
            <h2 id="vid-h">The short cut</h2>
            <p>30 s · dark mode · no sound · demo values</p>
          </div>
          <figure>
            <div class="cs2-video-frame">
              {/* Muted, no preload. It plays while half in view (scripts/case/page.ts) unless
                  reduced motion or a data saver is on; then a play button sits on the poster.
                  The poster is the video's own poster="" (Chrome's controls paint over anything
                  underneath), but it is set by page.ts only once the frame is within 200px of the
                  viewport: in the markup a poster="" is fetched with the page even with
                  preload="none". Without JS the <noscript> copy carries the poster directly. */}
              <div class="cs2-video-media">
                <video
                  controls
                  muted
                  playsinline
                  preload="none"
                  width="1280"
                  height="720"
                  aria-describedby={showVideo.description ? "vid-desc" : undefined}
                  data-poster-src={showVideo.poster}
                  data-case-video
                >
                  <source src={showVideo.src} type="video/mp4" />
                </video>
                <noscript>
                  <video
                    class="cs2-video-nojs"
                    controls
                    muted
                    playsinline
                    preload="none"
                    width="1280"
                    height="720"
                    poster={showVideo.poster}
                    aria-describedby={showVideo.description ? "vid-desc" : undefined}
                  >
                    <source src={showVideo.src} type="video/mp4" />
                  </video>
                </noscript>
              </div>
              <button class="cs2-video-play" type="button" hidden data-video-play>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4 2.5v11l9-5.5z" />
                </svg>
                Play<span class="sr-only"> the 30-second cut, no sound</span>
              </button>
            </div>
            <figcaption>
              {showVideo.caption}
              {showVideo.description && (
                <span id="vid-desc" class="cs2-vid-desc">
                  What plays: {showVideo.description}
                </span>
              )}
            </figcaption>
          </figure>
        </section>
      )}

      <section class="cs2-sec cs2-hl" aria-labelledby="hl-h">
        <h2 id="hl-h">{data.highlight.title}</h2>
        <figure>
          <slot name="highlight" />
          <figcaption>{data.highlight.caption}</figcaption>
        </figure>
      </section>

      <section class="cs2-sec cs2-how" id="how-it-works" aria-labelledby="how-h">
        <div class="cs2-how-head">
          <div>
            <h2 id="how-h">How it works</h2>
            <p set:html={richText(how.summary)} />
          </div>
          {how.stack.length > 0 && (
            <div>
              <dl class="cs2-stack" aria-label="Stack">
                {how.stack.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd>
                      {s.value}
                      {s.version && <code>{s.version}</code>}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="cs2-full">
                <a href="#stack" data-open-stack>
                  Full stack with versions
                </a>
              </p>
            </div>
          )}
        </div>
        {how.application && (
          <div class="cs2-how-sub">
            <h3>{how.application.title}</h3>
            <FlowDiagram
              id="app"
              cols={how.application.flow.cols}
              nodes={how.application.flow.nodes}
              edges={how.application.flow.edges}
              groups={how.application.flow.groups}
              label={how.application.flow.label}
              keyLabel={how.application.flow.keyLabel}
              lanes3Min={how.application.flow.lanes3Min}
              hint="Select any stage to see what it does, its tech and the decision behind it."
              accent={acc}
              autoplay={how.autoplay}
            />
          </div>
        )}
        {(how.architectureTitle || how.architectureNote) && (
          <div class="cs2-how-sub">
            {how.architectureTitle && <h3>{how.architectureTitle}</h3>}
            {how.architectureNote && <p set:html={richText(how.architectureNote)} />}
          </div>
        )}
        <FlowDiagram
          id="cs"
          cols={how.flow.cols}
          nodes={how.flow.nodes}
          edges={how.flow.edges}
          groups={how.flow.groups}
          label={how.flow.label}
          keyLabel={how.flow.keyLabel}
          lanes3Min={how.flow.lanes3Min}
          hint="Select any part to see what it does, its tech and the decision behind it."
          accent={acc}
          autoplay={how.autoplay}
        />
      </section>

      <section class="cs2-sec cs2-dives" id="deep-dives" aria-labelledby="dd-h">
        <h2 id="dd-h">Highlights</h2>
        {dive.map((x, i) => (
          <article class="hl-dv" id={`dive-${x.id}`} aria-labelledby={`dvh-${x.id}`}>
            <header class="hl-head">
              <p class="hl-n" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </p>
              <h3 id={`dvh-${x.id}`}>{x.title}</h3>
            </header>
            <FlowFigure scene={x.scene} point={x.point} />
            <p class="hl-cap" set:html={richText(x.shows)} />
            <details class="hl-more" data-dive>
              <summary>The detail</summary>
              <div class="hl-more-in">
                {x.paragraphs.map((p) => (
                  <p set:html={richText(p)} />
                ))}
              </div>
            </details>
          </article>
        ))}
      </section>

      {extra && (
        <section class="cs2-sec cs2-extra" id={extra.id} aria-labelledby="extra-h">
          <h2 id="extra-h">{extra.title}</h2>
          <div class="cs2-extra-in">
            <div class="cs2-dive-text">
              {extra.paragraphs.map((p) => (
                <p set:html={richText(p)} />
              ))}
            </div>
            <figure>
              <slot name="extra" />
              {extra.caption && <figcaption>{extra.caption}</figcaption>}
            </figure>
          </div>
        </section>
      )}

      <section class="cs2-sec cs2-limits" id="limits" aria-labelledby="lim-h">
        <h2 id="lim-h">Limits and what isn't shown</h2>
        <div class="cs2-limits-grid">
          <div>
            <h3>Not shown</h3>
            <ul>
              {limits.notShown.map((t) => (
                <li set:html={richText(t)} />
              ))}
            </ul>
          </div>
          <div>
            <h3>Not the main path, or not built yet</h3>
            <ul>
              {[...limits.deprecated, ...limits.reserved].map((t) => (
                <li set:html={richText(t)} />
              ))}
            </ul>
          </div>
        </div>
        <details class="cs2-more">
          <summary>Docs that lag the code (for developers)</summary>
          <ul>
            {limits.docsLag.map((t) => (
              <li set:html={richText(t)} />
            ))}
          </ul>
        </details>
        <details class="cs2-more" id="stack">
          <summary>Full stack with versions</summary>
          <div class="cs2-tables">
            {limits.stack.map((t) => (
              <table>
                <caption>{t.title}</caption>
                <thead>
                  <tr>
                    <th scope="col">Piece</th>
                    <th scope="col">Choice</th>
                  </tr>
                </thead>
                <tbody>
                  {t.rows.map(([a, b]) => (
                    <tr>
                      <th scope="row">{a}</th>
                      <td set:html={richText(b)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            ))}
          </div>
          <p class="cs2-note">{limits.stackSource}</p>
        </details>
      </section>

      <nav class="cs-next cs2-next" aria-label="More work">
        {prev && (
          <a href={`/work/${prev.id}`}>
            <span>Previous</span>
            <b>{prev.data.title}</b>
          </a>
        )}
        {next && (
          <a class="next" href={`/work/${next.id}`}>
            <span>Next</span>
            <b>{next.data.title}</b>
          </a>
        )}
      </nav>
      <p class="cs2-out">
        <a class="link" href="/#work">
          <Icon name="arrow" />
          Back to the work
        </a>
        <a class="link" href="/#contact">
          Contact
        </a>
      </p>

      {devTodos.length > 0 && (
        <aside class="cs2-todo cs2-devlist" data-dev-only hidden aria-labelledby="todo-h">
          <h2 id="todo-h">Still to confirm (shown with ?dev)</h2>
          <ul>
            {devTodos.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </article>
</Base>

<script>
  // Page views are tracked by pages/work/[slug].astro.
  import "~/scripts/case/page";
</script>
