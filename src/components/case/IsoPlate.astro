---
/**
 * One Highlights plate (HIGHLIGHTS-SPEC §2.3, §3): the scene drawn at build time for desktop and
 * phone, labels as HTML chips, the read-out, Replay and the tip sheet. The static HTML is the last
 * step of the default mode, so no-JS and reduced motion show the finished story.
 * Behaviour: scripts/case/plates.ts.
 */
import type { DivePlateCopy } from "~/lib/case";
import type { PlateScene } from "~/lib/iso/scene";

interface Props {
  /** `<slug>-<dive id>`; also the prefix of the sheet and description ids. */
  id: string;
  scene: PlateScene;
  plate: DivePlateCopy;
  caption: string;
}
const { id, scene, plate, caption } = Astro.props;
const mode = plate.mode ?? "d";
const dk = scene.draw(false, scene.cam.dk);
const ph = scene.draw(true, scene.cam.ph);
const N = dk.n;
const end = plate.read[mode]?.at(-1) ?? "";
const stages = [
  { cls: "dk", r: dk.render(scene.asp[0], 0.05, 600) },
  { cls: "ph", r: ph.render(scene.asp[1], 0.05, 300) },
];
const modes = plate.modes ?? [["d", "", ""] as [string, string, string]];
---

<div
  class="plate k-dive"
  data-fig={id}
  data-mode={mode}
  data-n={JSON.stringify(N)}
  data-read={JSON.stringify(plate.read)}
>
  <div class="cap-top" aria-hidden="true">
    <span class="ttl">{plate.title}</span>
    <span class="hint">{plate.hint}</span>
  </div>
  {stages.map(({ cls, r }) => (
    <div class={`stage ${cls}`}>
      <svg
        viewBox={r.K.viewBox}
        aria-hidden="true"
        focusable="false"
        preserveAspectRatio="xMidYMid meet"
        set:html={r.svg}
      />
      <div class="hl" set:html={r.html} />
    </div>
  ))}
  <div class="cap-bot">
    <output class="read" aria-live="polite">
      {end}
    </output>
    <button class="btn sm js-only" type="button" data-play aria-label="Replay this figure">
      Replay
    </button>
  </div>
  <div class="sheet" id={`${id}-sheet`} role="note" hidden>
    <b></b>
    <p></p>
    <button type="button" class="x" aria-label="Close note">
      ×
    </button>
  </div>
  <div class="sr-only" id={`${id}-desc`}>
    <p>
      {plate.title.toLowerCase()}: {caption}
    </p>
    {modes.map(([m, label, sub]) => (
      <>
        {plate.modes && <p>{`${label} (${sub}):`}</p>}
        <ol>
          {(plate.read[m] ?? []).map((s) => (
            <li>{s}</li>
          ))}
        </ol>
      </>
    ))}
  </div>
</div>
