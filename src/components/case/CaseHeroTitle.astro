---
/**
 * Hero A · Title: the project name is the hero. Without JS or with reduced motion the HTML
 * is the end state (the filled name). scripts/case/hero-a.ts plays the intro: the outline
 * letters rise, an accent scan line sweeps once and leaves the filled name behind. On scroll
 * the name lifts and shrinks a little.
 */
import type { CollectionEntry } from "astro:content";
import Icon from "~/components/Icon.astro";
import OrgLogo from "~/components/OrgLogo.astro";
import type { CaseStudyData } from "~/lib/case";
import { isWordmark, logoForWorkOrg } from "~/lib/orgs";

interface Props {
  entry: CollectionEntry<"work">;
  data: CaseStudyData;
}
const { entry, data } = Astro.props;
const d = entry.data;
const logo = logoForWorkOrg(d.org);
const words = (data.hero_name ?? d.title).split(" ");
// Fallback width when unmeasured: about 0.7em per letter of the longest word.
const w = data.hero_w ?? Math.max(...words.map((x) => x.length)) * 0.7;
---

<header class="cs-hero-a" data-hero-a>
  {logo && (
    <p class="cs-hero-a__meta">
      <OrgLogo src={logo.src} name={logo.name} named wordmark={isWordmark(logo)} />
    </p>
  )}

  <div class="cs-hero-a__stage" style={`--w:${w};--lines:${words.length}`}>
    <h1 id="cs-h" class="cs-hero-a__name">
      <span class="cs-hero-a__ol" aria-hidden="true">
        {words.map((x, i) => (
          <>
            {i > 0 && <br />}
            {x}
          </>
        ))}
      </span>
      <span class="cs-hero-a__fill">
        <span class="cs-hero-a__fill-in">
          {words.map((x, i) => (
            <>
              {i > 0 && " "}
              {i > 0 && <br />}
              {x}
            </>
          ))}
        </span>
      </span>
    </h1>
    {data.hero_tag && (
      <span class="cs-hero-a__sweep" aria-hidden="true">
        <i />
        <b>{data.hero_tag}</b>
      </span>
    )}
  </div>

  <div class="cs-hero-a__side">
    <p class="lede">{d.summary}</p>
    {data.credit && (
      <p class="cs2-credit" data-credit>
        {data.credit.lead}{" "}
        <a class="link" href={data.credit.href} rel="noopener">
          {data.credit.label}
        </a>
        {data.credit.rest}
      </p>
    )}
    {d.links.length > 0 && (
      <ul class="cs2-links" aria-label="Links">
        {d.links.map((l) => (
          <li>
            <a class="link" href={l.href} rel="noopener">
              {l.label}
              <Icon name="out" />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</header>
