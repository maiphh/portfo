---
/** Work and study, 2021 to 2028: a 96-month grid built from the experience collection. */
import { getCollection } from "astro:content";
import OrgLogo from "./OrgLogo.astro";
import { logoForExperience } from "~/lib/orgs";
import { TL_MONTHS, TL_YEARS, gridColumn, monthIndex, nowIndex } from "~/lib/timeline";

type Lane = "work" | "study" | "award" | "qualification";

const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const now = new Date();
const nowIdx = nowIndex(now);
const byLane = (lane: Lane) =>
  entries
    .filter((e) => e.data.lane === lane)
    .sort((a, b) => monthIndex(a.data.start) - monthIndex(b.data.start));
/** The phone timeline reads top to bottom in date order, not lane by lane. */
const chronological = [...entries].sort(
  (a, b) => monthIndex(a.data.start) - monthIndex(b.data.start) || a.data.order - b.data.order,
);

/** Dates belong to the axis (or the vertical rail), never to the card itself. */
const hasDate = /\b(?:19|20)\d{2}\b|\bnow\b|[–—]/;
const cardLabel = (detail: string) =>
  detail
    .split(" · ")
    .filter((part) => !hasDate.test(part))
    .join(" · ");
const period = (e: (typeof entries)[number]) => {
  const from = e.data.start.slice(0, 4);
  if (e.data.end) return `${from} – ${e.data.end.slice(0, 4)}`;
  return e.data.lane === "work" || e.data.lane === "study" ? `${from} – now` : from;
};

/** Bars that run past "now" get the striped future fill after the now line. */
function barStyle(start: string, end: string | undefined, row: number): string {
  const parts = [`--c:${gridColumn(start, end, now)}`, `--row:${row}`];
  if (end && monthIndex(end) + 1 > nowIdx) {
    const s = monthIndex(start);
    const span = monthIndex(end) + 1 - s;
    const pct = Math.max(0, Math.min(100, ((nowIdx - s) / span) * 100)).toFixed(1);
    parts.push(
      `background:linear-gradient(90deg,var(--sheet-2) ${pct}%,transparent ${pct}%),repeating-linear-gradient(135deg,var(--sheet-2) 0 8px,var(--sheet) 8px 16px)`,
    );
  }
  return parts.join(";");
}
/** Award and qualification marks are points; give the label two years of room. */
const markCol = (start: string) => {
  const s = monthIndex(start) + 1;
  return `--c:${s}/${Math.min(TL_MONTHS + 1, s + 23)}`;
};
/** Notes used to sit in a row under the grid; they now live in the hover/focus modal. */
type Entry = (typeof entries)[number];
const noteAttrs = (e: Entry) =>
  e.data.note
    ? {
        "data-note-id": e.id,
        "data-note-lead": e.data.note.lead,
        "data-note-text": e.data.note.text,
        tabindex: "0",
        role: "button" as const,
        "aria-label": `${e.data.title}. ${e.data.note.lead}. ${e.data.note.text}`,
      }
    : {};
const currentClass = (e: Entry) => (!e.data.end && e.data.lane === "work" ? " is-current" : "");
const nowP = (nowIdx / TL_MONTHS).toFixed(3);
---

<section class="sec" id="timeline" aria-labelledby="tl-h">
  <div class="wrap">
    <div class="head">
      <h2 id="tl-h" data-split>
        Work and study, 2021 to 2028
      </h2>
      <p>Two jobs, two degrees, one competition podium.</p>
    </div>
    <div class="tl" data-tl>
      <div class="tl-axis" aria-hidden="true">
        {TL_YEARS.map((y) => (
          <span>{y}</span>
        ))}
      </div>
      <div class="tl-grid">
        <div class="lane">
          <h3>Work</h3>
          <ol>
            {byLane("work").map((e) => {
              const logo = logoForExperience(e.id);
              return (
                <li
                  class={`bar work${currentClass(e)}`}
                  style={barStyle(e.data.start, e.data.end, e.data.row)}
                  data-tl-bar
                  {...noteAttrs(e)}
                >
                  {logo && <OrgLogo src={logo.src} name={logo.name} />}
                  <span class="bar-copy">
                    <b>{e.data.title}</b>
                    <span>{cardLabel(e.data.detail)}</span>
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
        <div class="lane">
          <h3>Study</h3>
          <ol>
            {byLane("study").map((e) => {
              const logo = logoForExperience(e.id);
              return (
                <li class="bar" style={barStyle(e.data.start, e.data.end, e.data.row)} data-tl-bar>
                  {logo && <OrgLogo src={logo.src} name={logo.name} />}
                  <span class="bar-copy">
                    <b>{e.data.title}</b>
                    <span>{cardLabel(e.data.detail)}</span>
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
        <div class="lane">
          <h3>Qualification</h3>
          <ol>
            {byLane("qualification").map((e) => {
              const logo = logoForExperience(e.id);
              return (
                <li class="mark mark-qual" style={markCol(e.data.start)} data-tl-mark>
                  {logo && <OrgLogo src={logo.src} name={logo.name} wordmark />}
                  <span>{e.data.title}</span>
                </li>
              );
            })}
          </ol>
        </div>
        <div class="lane">
          <h3>Awards</h3>
          <ol>
            {byLane("award").map((e) => {
              const logo = logoForExperience(e.id);
              return (
                <li class="mark" style={markCol(e.data.start)} data-tl-mark>
                  {logo && (
                    <OrgLogo src={logo.src} name={logo.name} named={e.id === "neo-league"} />
                  )}
                  <span>{e.data.title}</span>
                </li>
              );
            })}
          </ol>
        </div>
        <div class="now" style={`--p:${nowP}`} aria-hidden="true">
          <span>now</span>
        </div>
      </div>
      <ol class="tl-v" aria-label="Work and study timeline">
        {chronological.map((e) => {
          const logo = logoForExperience(e.id);
          const label = cardLabel(e.data.detail);
          return (
            <li
              class={`tl-v-item is-${e.data.lane}${currentClass(e)}`}
              data-tl-v-item
              {...noteAttrs(e)}
            >
              <span class="tl-v-node" aria-hidden="true"></span>
              <span class="tl-v-when" aria-hidden="true">
                {period(e)}
              </span>
              <div class="tl-v-card" data-tl-bar>
                {logo && (
                  <OrgLogo
                    src={logo.src}
                    name={logo.name}
                    named={e.id === "neo-league"}
                    wordmark={e.id === "ielts"}
                  />
                )}
                <span class="tl-v-copy">
                  <b>{e.data.title}</b>
                  {label && <span class="tl-v-sub">{label}</span>}
                </span>
              </div>
            </li>
          );
        })}
      </ol>
      <div class="tl-modal" data-tl-modal hidden role="dialog" aria-label="Timeline details">
        <button class="tl-modal-close" type="button" data-tl-close aria-label="Close details">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
        <b data-tl-modal-lead></b>
        <p data-tl-modal-text></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTimelineNotes } from "~/scripts/timeline";
  initTimelineNotes();
</script>
