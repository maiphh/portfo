---
import type { Credit } from "~/lib/credit";
import { USE_MOCKS } from "~/lib/flags";
import { site } from "~/lib/site";

interface Props {
  base?: "" | "/";
  /** A one-line credit under the footer row (the case studies' iso-glow figures). */
  credit?: Credit | undefined;
}
const { base = "", credit } = Astro.props;
// the credit text around its linked word, or null when there is no link to place
const at = credit?.link ? credit.text.indexOf(credit.link.label) : -1;
const cr =
  credit?.link && at >= 0
    ? [credit.text.slice(0, at), credit.text.slice(at + credit.link.label.length)]
    : credit?.link
      ? [`${credit.text} · `, ""]
      : null;
---

<footer>
  <div class="wrap">
    <p class="foot-name" aria-hidden="true" data-footname>
      {site.name}
    </p>
    <div class="foot-row">
      <span>
        {site.role} · {site.city}
        {USE_MOCKS && base === "" && " · Figures marked † are sample data"}
      </span>
      <nav aria-label="Footer">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github}>GitHub</a>
        <button type="button" class="foot-chat" data-chat-open>
          Ask my assistant
        </button>
        <a href={base ? "/" : "#top"}>Back to top</a>
      </nav>
    </div>
    {credit && (
      <p class="foot-credit">
        {cr ? (
          <>
            {cr[0]}
            <a href={credit.link?.href} rel="noopener">
              {credit.link?.label}
            </a>
            {cr[1]}
          </>
        ) : (
          credit.text
        )}
      </p>
    )}
  </div>
</footer>
