---
import type { Credit } from "~/lib/credit";
import { USE_MOCKS } from "~/lib/flags";
import { site } from "~/lib/site";

interface Props {
  base?: "" | "/";
  /** A one-line credit under the footer row (the case studies' iso-glow figures). */
  credit?: Credit | undefined;
}
const { base = "", credit } = Astro.props;
---

<footer>
  <div class="wrap">
    <p class="foot-name" aria-hidden="true" data-footname>
      {site.name}
    </p>
    <div class="foot-row">
      <span>
        {site.role} · {site.city}
        {USE_MOCKS && base === "" && " · Figures marked † are sample data"}
      </span>
      <nav aria-label="Footer">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github}>GitHub</a>
        <button type="button" class="foot-chat" data-chat-open>
          Ask my assistant
        </button>
        <a href={base ? "/" : "#top"}>Back to top</a>
      </nav>
    </div>
    {credit && (
      <p class="foot-credit">
        {credit.text}
        {credit.link && (
          <>
            {" · "}
            <a href={credit.link.href} rel="noopener">
              {credit.link.label}
            </a>
          </>
        )}
      </p>
    )}
  </div>
</footer>
