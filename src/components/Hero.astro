---
import Icon from "./Icon.astro";
import { asciiPortrait } from "~/data/ascii-portrait";
import { site } from "~/lib/site";
import "~/styles/ascii-hero.css";
---

<section class="hero" id="top" aria-labelledby="h1" data-hero>
  <div class="hero-stage" data-ascii-stage>
    <div class="ascii-frame" data-ascii-frame>
      <pre class="ascii-fallback" aria-hidden="true">{asciiPortrait}</pre>
      <canvas class="ascii-canvas" data-ascii-canvas aria-hidden="true"></canvas>
    </div>
  </div>
  <div class="hero-role" data-h>
    <p class="role-place">Ho Chi Minh City · VN</p>
    <h1 class="hero-name" id="h1" aria-label={site.name}>
      Mai Phú
    </h1>
    <p class="role-copy">At Talentnet · previously Garena Free Fire</p>
  </div>
  <div class="hero-bottom">
    <p class="role-title" data-h>
      AI Engineer<span>.</span>
    </p>
    <div class="hero-actions" data-h>
      <a class="btn hero-work" href="#work">
        See the work <Icon name="arrow" />
      </a>
      <div class="hero-links">
        <a href={`mailto:${site.email}`}>Email me</a>
        <a href={site.cv} download={site.cvFile}>
          Download CV
        </a>
      </div>
    </div>
  </div>
</section>
