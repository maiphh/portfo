---
/**
 * How this site works: the real architecture (workers/portfo, astro.config.mjs) as a flow.
 * Keep this in step with docs/architecture.md when the architecture changes.
 */
import FlowDiagram from "~/components/flow/FlowDiagram.astro";
import type { FlowEdge, FlowNode } from "~/lib/flow/types";

// Wide layout: 4 columns × 5 rows. DOM order is the order a visit uses the parts.
const nodes: FlowNode[] = [
  {
    id: "browser",
    title: "Your browser",
    sub: "this page",
    at: [3, 1],
    mAt: [1, 2],
    mAt2: [2, 1],
    details: {
      does: "Loads prebuilt pages, then calls the Worker directly for contact, page views, GitHub activity and chat.",
      tech: ["Astro islands, no framework runtime", "`fetch` + server-sent events for chat"],
      why: "No backend sits between the page and the Worker, so nothing runs unless you use it.",
    },
  },
  {
    id: "pages",
    title: "Static pages",
    sub: "Vercel · prebuilt",
    at: [1, 1],
    mAt: [1, 1],
    mAt2: [1, 1],
    details: {
      does: "Serves every page as prebuilt HTML, CSS and JS. Only a small health check runs on demand.",
      tech: ["Astro, static output", "`@astrojs/vercel` adapter"],
      why: "Static pages are fast and cheap to host. Everything dynamic lives in one Worker.",
    },
  },
  {
    id: "worker",
    title: "portfo Worker",
    sub: "contact · views · chat",
    at: [3, 2],
    mAt: [2, 2],
    mAt2: [3, 1],
    key: true,
    details: {
      does: "One Cloudflare Worker for everything dynamic: `/contact`, `/view`, `/popular`, `/activity` and `/chat`, plus the scheduled GitHub sync.",
      tech: [
        "Cloudflare Workers, TypeScript",
        "D1, Workers AI, a Durable Object and Rate Limiting bindings",
      ],
      why: "One deploy and one set of bindings instead of separate services for chat and data.",
    },
  },
  {
    id: "d1",
    title: "Cloudflare D1",
    sub: "messages · views · GitHub",
    at: [1, 3],
    mAt: [3, 1],
    mAt2: [4, 1],
    key: true,
    details: {
      does: "Stores contact messages, page views and a snapshot of public GitHub repos and activity.",
      tech: ["SQLite on D1", "views keyed by `visitor_hash`: SHA-256(IP + UA + daily salt)"],
      why: "No cookies and no raw IPs. One view per visitor, page and day.",
    },
  },
  {
    id: "quota",
    title: "Chat limits",
    sub: "Durable Object · rate limit",
    at: [2, 3],
    mAt: [3, 2],
    mAt2: [4, 2],
    key: true,
    details: {
      does: "Caps the chat: 3 messages per 10 seconds, about 10 per visitor every 10 minutes, 50 a day in total.",
      tech: ["Rate Limiting binding (burst)", "`Quota` Durable Object (window and daily budget)"],
      why: "The Rate Limiting binding only supports 10 s or 60 s periods, so longer windows live in a Durable Object.",
    },
  },
  {
    id: "ai",
    title: "Workers AI",
    sub: "Llama 3.3 · tool calling",
    at: [3, 3],
    mAt: [2, 3],
    mAt2: [5, 1],
    key: true,
    details: {
      does: "Answers chat questions only from tool results: projects, experience, contact details and GitHub stats.",
      tech: [
        "Llama 3.3 70B (fp8-fast), Llama 3.1 8B fallback",
        "read-only tools over bundled JSON and D1",
      ],
      why: 'Small, typed tools instead of vector search: answers cite their sources, and unknowns get a plain "I don\'t know".',
    },
  },
  {
    id: "resend",
    title: "Resend",
    sub: "one email per message",
    at: [4, 3],
    mAt: [3, 3],
    mAt2: [6, 1],
    details: {
      does: "Sends me each contact message in the same request that stored it. Reply-to is the sender.",
      tech: ["Resend HTTP API", "called from the Worker"],
      why: "No queue: you see right away whether the message went through. If the email fails, the message is kept and you're told.",
    },
  },
  {
    id: "email",
    title: "Email to Phu",
    sub: "reply-to is you",
    at: [4, 4],
    mAt: [4, 3],
    mAt2: [6, 2],
    details: {
      does: "Lands in my inbox; replying goes straight to the address you entered.",
      tech: ["plain text email"],
      why: "Your message reaches a person, not a ticket system.",
    },
  },
  {
    id: "cron",
    title: "Cron Trigger",
    sub: "every 6 hours",
    at: [5, 1],
    mAt: [1, 3],
    mAt2: [2, 2],
    key: true,
    details: {
      does: "Runs the Worker's GitHub sync on a schedule, so pages read a snapshot instead of calling GitHub.",
      tech: ["Cloudflare Cron Trigger `17 */6 * * *`", "staging table, then a swap"],
      why: "Visitors never wait on GitHub, and its rate limits never reach the page.",
    },
  },
  {
    id: "github",
    title: "GitHub API",
    sub: "public repos and activity",
    at: [5, 3],
    mAt: [2, 1],
    mAt2: [3, 2],
    details: {
      does: "Source of the public repositories and contribution activity shown on the site.",
      tech: ["GitHub GraphQL API", "read-only token"],
      why: "Only public data is synced, and only by the cron job.",
    },
  },
];

const edges: FlowEdge[] = [
  ["browser", "pages"],
  ["browser", "worker"],
  ["worker", "d1"],
  ["worker", "quota"],
  ["worker", "ai"],
  ["worker", "resend"],
  ["resend", "email"],
  ["cron", "worker"],
  ["worker", "github"],
];
---

<section class="sec chapter" id="how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="head">
      <h2 id="how-h" data-split>
        How this site works
      </h2>
      <p>
        Static pages on Vercel, one Cloudflare Worker for contact, views, GitHub and chat. Nothing
        runs that doesn't need to. Select any part to see what it does.
      </p>
    </div>
    <FlowDiagram
      id="how"
      cols={4}
      nodes={nodes}
      edges={edges}
      label="Parts of this site, in the order a visit uses them"
      keyLabel="runs on Cloudflare"
      hint="Select any part of the diagram to see what it does, the tech behind it and the key decision."
      packets
      autoplay
    />
    <div class="how-notes">
      <p>
        <b>The chat</b> runs on the same Cloudflare Worker as the data APIs. It only answers from
        tool results (bundled site JSON and D1) and lists its sources.
      </p>
      <p>
        <b>Your message</b> is validated, stored in D1, and emailed to me in the same request. A
        honeypot field catches simple bots. No captcha, no job queue and no LLM sorting.
      </p>
      <p>
        <b>Guardrails</b> are a honeypot on the form, about 10 chat messages per visitor every 10
        minutes and a daily AI budget on the Worker.
      </p>
    </div>
  </div>
</section>
